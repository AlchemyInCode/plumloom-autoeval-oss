# Copy to .github/workflows/autoeval-suite-gate.yml in your own repo and remove
# the .example extension. Then configure these repository values:
#   - secret   AUTOEVAL_API_KEY         your Plumloom CLI key (pl_sk_...)
#   - variable AUTOEVAL_API_BASE_URL    the Autoeval API origin (https, no path)
#   - variable AUTOEVAL_WORKSPACE_ID    the workspace returned by `autoeval workspace list`
#   - variable AUTOEVAL_JUDGE_MODEL_ID  an enabled model returned by `autoeval models`
#   - variable AUTOEVAL_PRIMARY_MODEL_ID an enabled model used by scenario evaluations
# The CLI reads the key from the environment, so it never appears on the
# command line or on disk. The runtime ID overrides keep real account IDs
# out of committed example files.
#
# Before enabling this workflow, commit evals/autoeval.suite.yaml and every eval,
# artifact, and reference file it names. Paths resolve relative to the manifest
# or eval file that contains them. As a starting point, copy examples/suite/
# autoeval.suite.yaml and the examples/smoke/fixtures files it references, then
# adjust those paths for your repository. Those public examples contain
# synthetic IDs; the runtime overrides below replace the manifest workspace
# and every evaluation's judge model ID, plus the primary model used by any
# scenario evaluations.
name: Autoeval suite gate

on:
  pull_request:

permissions:
  contents: read

jobs:
  gate:
    # Pull requests from forks do not receive repository secrets.
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    env:
      AUTOEVAL_API_KEY: ${{ secrets.AUTOEVAL_API_KEY }}
      AUTOEVAL_API_BASE_URL: ${{ vars.AUTOEVAL_API_BASE_URL }}
      AUTOEVAL_WORKSPACE_ID: ${{ vars.AUTOEVAL_WORKSPACE_ID }}
      AUTOEVAL_JUDGE_MODEL_ID: ${{ vars.AUTOEVAL_JUDGE_MODEL_ID }}
      AUTOEVAL_PRIMARY_MODEL_ID: ${{ vars.AUTOEVAL_PRIMARY_MODEL_ID }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      # Pinning prevents CLI-version drift and improves reproducibility, but model
      # and judge behavior can still make evaluation results vary between runs.
      - run: npm install --global @plumloom/cli@0.1.3
      - name: Verify runtime configuration
        run: |
          test -n "$AUTOEVAL_API_KEY"
          test -n "$AUTOEVAL_API_BASE_URL"
          test -n "$AUTOEVAL_WORKSPACE_ID"
          test -n "$AUTOEVAL_JUDGE_MODEL_ID"
          test -n "$AUTOEVAL_PRIMARY_MODEL_ID"
      - name: Pre-flight
        run: >-
          autoeval doctor
          --manifest evals/autoeval.suite.yaml
          --workspace "$AUTOEVAL_WORKSPACE_ID"
          --judge-model-id "$AUTOEVAL_JUDGE_MODEL_ID"
          --primary-model-id "$AUTOEVAL_PRIMARY_MODEL_ID"
      - name: Release gate
        run: >-
          autoeval suite gate
          --manifest evals/autoeval.suite.yaml
          --workspace "$AUTOEVAL_WORKSPACE_ID"
          --judge-model-id "$AUTOEVAL_JUDGE_MODEL_ID"
          --primary-model-id "$AUTOEVAL_PRIMARY_MODEL_ID"
