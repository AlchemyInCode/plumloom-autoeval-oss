# Copy to .github/workflows/autoeval-suite-gate.yml in your own repo and remove
# the .example extension. Then configure these repository values:
#   - secret   AUTOEVAL_API_KEY         your Plumloom CLI key (pl_sk_...)
#   - variable AUTOEVAL_WORKSPACE_ID    the workspace returned by `autoeval workspace list`
#   - variable AUTOEVAL_JUDGE_MODEL_ID  an enabled model returned by `autoeval models`
#   - optional variable AUTOEVAL_PRIMARY_MODEL_ID  an enabled model used to override
#     the primary model in scenario evaluations; omit it for conversation- or
#     agent-trace-only suites
# The CLI reads the key from the environment, so it never appears on the
# command line or on disk. The runtime ID overrides keep real account IDs
# out of committed example files.
#
# This workflow always reads evals/autoeval.suite.yaml. Commit that manifest and
# every eval, artifact, and reference file it names. Paths in the manifest are
# relative to evals/. For the agent-trace demo, copy one matching pair:
#   PASS: examples/ci-gate-demo/pass.suite.yaml -> evals/autoeval.suite.yaml
#         examples/evals/agent-trace-basic.json -> evals/agent-trace-basic.json
#   FAIL: examples/ci-gate-demo/fail.suite.yaml -> evals/autoeval.suite.yaml
#         examples/evals/agent-trace-bad-decision.json ->
#           evals/agent-trace-bad-decision.json
# In the copied manifest, change its eval entry from ../evals/<fixture>.json to
# ./<fixture>.json. The runtime overrides below replace the synthetic workspace
# and judge model IDs. Set AUTOEVAL_PRIMARY_MODEL_ID only when a scenario eval's
# committed primary model ID also needs to be overridden.
name: Autoeval suite gate

on:
  pull_request:

permissions:
  contents: read
  # Required only for the same-repository reliability report comment.
  pull-requests: write

jobs:
  gate:
    # Pull requests from forks do not receive repository secrets.
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    env:
      AUTOEVAL_API_KEY: ${{ secrets.AUTOEVAL_API_KEY }}
      AUTOEVAL_WORKSPACE_ID: ${{ vars.AUTOEVAL_WORKSPACE_ID }}
      AUTOEVAL_JUDGE_MODEL_ID: ${{ vars.AUTOEVAL_JUDGE_MODEL_ID }}
      AUTOEVAL_PRIMARY_MODEL_ID: ${{ vars.AUTOEVAL_PRIMARY_MODEL_ID }}
      AUTOEVAL_PR_RELIABILITY_COMMENT: 'true'
      # Use a stable, unique value per matrix cell when adding a matrix strategy.
      AUTOEVAL_REPORT_MATRIX_ID: default
      GITHUB_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      # Pinning prevents CLI-version drift and improves reproducibility, but model
      # and judge behavior can still make evaluation results vary between runs.
      - run: npm install --global @plumloom/cli@0.1.4
      - name: Verify runtime configuration
        run: |
          test -n "$AUTOEVAL_API_KEY"
          test -n "$AUTOEVAL_WORKSPACE_ID"
          test -n "$AUTOEVAL_JUDGE_MODEL_ID"
      - name: Pre-flight
        shell: bash
        run: |
          set -euo pipefail
          arguments=(
            --manifest evals/autoeval.suite.yaml
            --workspace "$AUTOEVAL_WORKSPACE_ID"
            --judge-model-id "$AUTOEVAL_JUDGE_MODEL_ID"
          )
          if [[ -n "${AUTOEVAL_PRIMARY_MODEL_ID:-}" ]]; then
            arguments+=(--primary-model-id "$AUTOEVAL_PRIMARY_MODEL_ID")
          fi
          autoeval doctor "${arguments[@]}"
      - name: Release gate
        shell: bash
        run: |
          set -euo pipefail
          arguments=(
            --manifest evals/autoeval.suite.yaml
            --workspace "$AUTOEVAL_WORKSPACE_ID"
            --judge-model-id "$AUTOEVAL_JUDGE_MODEL_ID"
          )
          if [[ -n "${AUTOEVAL_PRIMARY_MODEL_ID:-}" ]]; then
            arguments+=(--primary-model-id "$AUTOEVAL_PRIMARY_MODEL_ID")
          fi
          autoeval suite gate "${arguments[@]}"
